# Copia este archivo a .env.local y llena los valores.
# Todo lo que empieza con NEXT_PUBLIC_ se incrusta en el bundle al compilar:
# aqui no van llaves ni secretos, solo identificadores publicos.
#
# Al cambiar cualquiera de estos valores hay que borrar .next antes de volver a
# construir. La cache de Turbopack no siempre nota el cambio y el build sale con
# el valor anterior:
#   rm -rf .next && npm run build:static

# Endpoint del proveedor de formularios al que se mandan las suscripciones.
# Vacio = el sitio NO muestra formulario y dice "Muy pronto podrás suscribirte
# aquí", para no pedir un correo que no se puede honrar.
# El origen de esta URL se agrega solo a connect-src de la CSP durante el build.
NEXT_PUBLIC_LEAD_ENDPOINT=

# Contenedor de Google Tag Manager, con formato GTM-XXXXXXX.
# Vacio o con otro formato = GTM no se carga.
NEXT_PUBLIC_GTM_ID=

# Directorio Derma Finder: "off" (por defecto) u "off"/"demo".
# "demo" muestra especialistas FICTICIOS; solo para revisiones internas.
NEXT_PUBLIC_DERMA_FINDER_MODE=
